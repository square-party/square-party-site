<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.name }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="stylesheet" href="/assets/css/main.css">

  <!-- Open Graph / Twitter Card -->
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/{{ ogImage or 'og-image.png' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title or site.name }}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/img/{{ ogImage or 'og-image.png' }}">
</head>
<body class="{{ bodyClass | default('') }}">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <nav class="site-nav" aria-label="Site">
      <a class="site-nav__brand" href="/">{{ site.name }}</a>
      <button class="site-nav__toggle" type="button"
              data-nav-toggle
              aria-controls="site-nav-menu"
              aria-expanded="false"
              aria-label="Open menu">
        <span class="site-nav__toggle-bar" aria-hidden="true"></span>
        <span class="site-nav__toggle-bar" aria-hidden="true"></span>
        <span class="site-nav__toggle-bar" aria-hidden="true"></span>
      </button>
      <ul class="site-nav__links" id="site-nav-menu">
        <li data-dropdown class="dropdown--align-left">
          <button class="dropdown-trigger" data-dropdown-trigger aria-haspopup="true" aria-expanded="false">
            The Party <span class="caret" aria-hidden="true">▾</span>
          </button>
          <ul class="dropdown-panel" data-dropdown-panel>
            <li class="dropdown-panel__hint">What it is</li>
            <li><a href="/square-party/">Overview</a></li>
            <li><a href="/square-party/lineage/">Lineage</a></li>
            <li><a href="/square-party/assembly/">People's Assembly</a></li>
            <li><a href="/square-party/connections/">Connections</a></li>
            <li><a href="/square-party/tenets/">Tenets</a></li>
          </ul>
        </li>
        <li><a href="/representation/">Representation</a></li>
        <li><a href="/paul/campaign/empower/">Empower</a></li>
        <li data-dropdown>
          <button class="dropdown-trigger" data-dropdown-trigger aria-haspopup="true" aria-expanded="false">
            Tools <span class="caret" aria-hidden="true">▾</span>
          </button>
          <ul class="dropdown-panel" data-dropdown-panel>
            <li><a href="/square/">Make a square</a></li>
            <li><a href="/gallery/">Square gallery</a></li>
            <li><a href="/income-viz/">Income visualizations</a></li>
          </ul>
        </li>
        <li><a href="/ideas/">Ideas</a></li>
        <li><a href="/contribute/">Contribute</a></li>
        <li><a href="/saved/">Saved</a></li>
        <li data-dropdown>
          <button class="dropdown-trigger" data-dropdown-trigger aria-haspopup="true" aria-expanded="false">
            Paul <span class="caret" aria-hidden="true">▾</span>
          </button>
          <ul class="dropdown-panel" data-dropdown-panel>
            <li class="dropdown-panel__hint">Bio &amp; campaign</li>
            <li><a href="/paul/">About Paul</a></li>
            <li><a href="/paul/campaign/">PA-3 campaign</a></li>
            <li><a href="/paul/campaign/empower/">Empower (PA-3 application)</a></li>
            <li><a href="/paul/campaign/empower/parks/">PA-3 parks map</a></li>
            <li><a href="/paul/policy/">Policy areas</a></li>
            <li><a href="/paul/campaign/empower/contribute/">Contribute</a></li>
          </ul>
        </li>
      </ul>
    </nav>
  </header>

  {% include "partials/layer-toggle.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>{{ site.name }}</p>
    <p class="site-footer__meta">
      A vehicle for civic reform.
    </p>
    <p class="site-footer__meta">
      <a href="/newsletter/">Newsletter →</a>
    </p>
  </footer>

  <script src="/assets/js/site.js" defer></script>
</body>
</html>
