{# Empty square — the party's signature visual. Solid frame, empty inside on purpose.

   Fill color is controlled by --square-fill on .home-landing__square (defined
   in main.css under the empty-square block). Change it there to recolor the
   square independently of the page background.
#}
<div class="home-landing__square" aria-label="The party's square — empty on purpose">
  <svg class="home-landing__square-svg"
       viewBox="0 0 280 280"
       width="280"
       height="280"
       xmlns="http://www.w3.org/2000/svg"
       aria-hidden="true">
    <rect class="home-landing__square-rect"
          x="1" y="1" width="278" height="278" />
  </svg>
</div>
