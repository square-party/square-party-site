{#
  arch-gap-annotation.njk — annotation for aspects with null magnitude.
  Reads `profile` from scope.

  Architectural-gap aspects don't fit on the stack bar (no dollar value to
  place). This partial renders them as a footnote-style annotation below the
  viz, tagged with data-aspect-kind="gap" so the mode-driven CSS emphasis
  rules (driven by [data-design] / [data-gap] on the page-wrapper) apply
  the same dimming/saturation treatment as the bar segments.

  Uses proseByMode.synthesis as the annotation text; falls back to the bare
  prose field if present (M1 data-model compatibility).
#}
{%- for aspect in profile.aspects -%}
  {%- if aspect.magnitude == null or aspect.gapKind == "architectural" %}
  <p
    class="viz-arch-gap-note"
    data-aspect-id="{{ aspect.id }}"
    data-aspect-kind="{{ aspect.kind }}"
  >
    <strong>Architectural gap (no magnitude shown above):</strong>
    {{ aspect.proseByMode.synthesis or aspect.prose }}
  </p>
  {%- endif %}
{%- endfor %}
