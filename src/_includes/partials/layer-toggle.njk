{# Layer toggle — two independent on/off layers (Light / Dark) that compose
   freely on the neutral baseline. Persisted to localStorage by site.js.
   On mobile collapses to a horizontal row at bottom-right.
#}
<aside class="layer-toggle" role="region" aria-label="Layer toggles">
  <p class="layer-toggle__label">Layers</p>
  <button class="layer-toggle__btn" data-layer="light" type="button" aria-pressed="false">
    <span class="layer-toggle__name">Light</span>
    <span class="layer-toggle__hint">hope · agency</span>
  </button>
  <button class="layer-toggle__btn" data-layer="dark" type="button" aria-pressed="false">
    <span class="layer-toggle__name">Dark</span>
    <span class="layer-toggle__hint">stakes · costs</span>
  </button>
</aside>
