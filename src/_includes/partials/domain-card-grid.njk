{# Domain index — compact title list with sticky detail panel.
   Each row in the list = title + state dot + hover arrow (~36px tall).
   The detail panel on the right pre-populates with the first domain on
   page load and updates on hover/focus. Click a row to navigate.
   On mobile, the panel collapses and descriptions move inline under titles.

   IMPORTANT: do not introduce blank lines inside the .domain-index HTML block —
   they terminate markdown-it's HTML block parsing. Pack tightly.
#}
<div class="domain-index" id="domains">
<ul class="domain-list">
{%- for domain in collections.domains -%}
{%- set state = domain.data.state or "planned" -%}
{%- if state == "published" %}{% set stateLabel = "Published" %}{% elif state == "in-review" %}{% set stateLabel = "Ready for review" %}{% elif state == "drafting" %}{% set stateLabel = "Drafting" %}{% else %}{% set stateLabel = "Planned" %}{% endif -%}
<li class="domain-row"><a class="domain-row__link" href="{{ domain.url }}" data-title="{{ domain.data.title }}" data-description="{{ domain.data.description | escape }}" data-state="{{ state }}" data-state-label="{{ stateLabel }}"><span class="dot" data-state="{{ state }}" aria-hidden="true"></span><span class="domain-row__title">{{ domain.data.title }}</span>{% if state != "planned" %}<span class="domain-row__state" data-state="{{ state }}">{{ stateLabel }}</span>{% endif %}<span class="domain-row__arrow" aria-hidden="true">→</span></a><p class="domain-row__desc-mobile">{{ domain.data.description }}</p></li>
{%- endfor %}
</ul>
<aside class="domain-detail" aria-label="Domain detail">
<span class="domain-detail__state" data-state="planned" hidden></span>
<h3 class="domain-detail__title">Domain detail</h3>
<p class="domain-detail__desc">Hover or focus a domain to see what it covers. Click any row to open that domain's analysis.</p>
<p class="domain-detail__cta"><a class="domain-detail__open" href="#" hidden>Open this domain →</a></p>
</aside>
</div>
