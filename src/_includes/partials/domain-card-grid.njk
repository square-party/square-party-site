{# Domain index — clustered title list with sticky detail panel.
   Domains are grouped by `cluster` letter (A–H, see DOMAIN_FRAMEWORK §6 and
   src/_data/clusters.json). The list walks the pre-sorted collection and
   emits a section heading whenever the cluster changes. The detail panel
   on the right pre-populates with the first domain on page load and updates
   on hover/focus. Click a row to navigate. On mobile the panel collapses
   and descriptions move inline under titles.

   IMPORTANT: do not introduce blank lines inside the .domain-index HTML
   block — they terminate markdown-it's HTML block parsing. Pack tightly.
#}
<div class="domain-index" id="domains">
<div class="domain-list">
{%- set currentCluster = "" -%}
{%- for domain in collections.domains -%}
{%- set state = domain.data.state or "planned" -%}
{%- if state == "published" %}{% set stateLabel = "Published" %}{% elif state == "in-review" %}{% set stateLabel = "Ready for review" %}{% elif state == "drafting" %}{% set stateLabel = "Drafting" %}{% else %}{% set stateLabel = "Planned" %}{% endif -%}
{%- set cluster = domain.data.cluster or "Z" -%}
{%- if cluster != currentCluster -%}
{%- if currentCluster != "" %}</ul></section>{% endif -%}
<section class="domain-cluster" data-cluster="{{ cluster }}"><h3 class="domain-cluster__heading"><button class="domain-cluster__toggle" type="button" data-cluster-toggle="{{ cluster }}" aria-expanded="false" aria-controls="domain-cluster-{{ cluster }}"><span class="domain-cluster__caret" aria-hidden="true">▾</span><span class="domain-cluster__title">{{ clusters[cluster] or "Other" }}</span></button></h3><ul class="domain-cluster__list" id="domain-cluster-{{ cluster }}">
{%- set currentCluster = cluster -%}
{%- endif -%}
{%- set rowTitle = domain.data.shortTitle or domain.data.title -%}
<li class="domain-row"><a class="domain-row__link" href="{{ domain.url }}" data-title="{{ domain.data.title }}" data-description="{{ domain.data.description | escape }}" data-state="{{ state }}" data-state-label="{{ stateLabel }}"><span class="dot" data-state="{{ state }}" aria-hidden="true"></span><span class="domain-row__title">{{ rowTitle }}</span>{% if state != "planned" %}<span class="domain-row__state" data-state="{{ state }}">{{ stateLabel }}</span>{% endif %}<span class="domain-row__arrow" aria-hidden="true">→</span></a><p class="domain-row__desc-mobile">{{ domain.data.description }}</p></li>
{%- endfor -%}
{%- if currentCluster != "" %}</ul></section>{% endif %}
</div>
<aside class="domain-detail" aria-label="Domain detail">
<span class="domain-detail__state" data-state="planned" hidden></span>
<h3 class="domain-detail__title">Domain detail</h3>
<p class="domain-detail__desc">Open any cluster to see the domains inside, then hover or focus a domain to see what it covers. Click any row to open that domain's analysis.</p>
<p class="domain-detail__cta"><a class="domain-detail__open" href="#" hidden>Open this domain →</a></p>
</aside>
</div>
