{#
  domain-honeycomb.njk — visual honeycomb of the verified-13 domains on the
  empower landing.

  Two SVGs are emitted: a 4-5-4 stagger for desktop and a 3-2-3-2-3 stagger
  for mobile. CSS controls which is visible at each viewport. Cells render
  in collection order (alphabetical by title — see eleventy.config.js).

  Reads collections.verifiedDomains. Labels go through partials/domain-label.njk
  so the single-source-of-truth pattern is preserved. Multi-word short titles
  split to two lines inline within the for loop.

  No imposed ordering visible to a reader: honeycomb adjacency is symmetric,
  every cell has up to six equally-prominent neighbors.

  Click-target override (opt-in, per domain):
    By default each hex links to domain.url (the domain's own home page —
    derived by Eleventy from the source-file location). To redirect a
    specific hex elsewhere — say, to a sub-page or a deep link — add a
    `honeycombLink:` field to that domain's frontmatter and set it to the
    desired path. The partial reads `domain.data.honeycombLink or domain.url`,
    so the override applies only where set; unset domains keep the default.

    Example (in src/paul/campaign/empower/domain/finance-taxation/index.njk):
      honeycombLink: /paul/campaign/empower/domain/finance-taxation/neighbors/
#}
{%- import "partials/domain-label.njk" as domainLabel -%}

{#- Pre-computed hex polygon points (pointy-top hexagons). -#}
{#- Desktop: side s=50; width √3·s ≈ 86.6; row spacing 1.5·s = 75.
    Row 1 (cy=70): 4 hexes at cx 155, 245, 335, 425.
    Row 2 (cy=145): 5 hexes at cx 110, 200, 290, 380, 470.
    Row 3 (cy=220): 4 hexes at cx 155, 245, 335, 425. -#}
{%- set desktopPoints = [
  "155,20 198.3,45 198.3,95 155,120 111.7,95 111.7,45",
  "245,20 288.3,45 288.3,95 245,120 201.7,95 201.7,45",
  "335,20 378.3,45 378.3,95 335,120 291.7,95 291.7,45",
  "425,20 468.3,45 468.3,95 425,120 381.7,95 381.7,45",
  "110,95 153.3,120 153.3,170 110,195 66.7,170 66.7,120",
  "200,95 243.3,120 243.3,170 200,195 156.7,170 156.7,120",
  "290,95 333.3,120 333.3,170 290,195 246.7,170 246.7,120",
  "380,95 423.3,120 423.3,170 380,195 336.7,170 336.7,120",
  "470,95 513.3,120 513.3,170 470,195 426.7,170 426.7,120",
  "155,170 198.3,195 198.3,245 155,270 111.7,245 111.7,195",
  "245,170 288.3,195 288.3,245 245,270 201.7,245 201.7,195",
  "335,170 378.3,195 378.3,245 335,270 291.7,245 291.7,195",
  "425,170 468.3,195 468.3,245 425,270 381.7,245 381.7,195"
] -%}
{%- set desktopCenters = [
  [155, 70], [245, 70], [335, 70], [425, 70],
  [110, 145], [200, 145], [290, 145], [380, 145], [470, 145],
  [155, 220], [245, 220], [335, 220], [425, 220]
] -%}

{#- Mobile: side s=38; width √3·s ≈ 65.8; row spacing 1.5·s = 57.
    Rows of 3-2-3-2-3 hexes for 13 total. -#}
{%- set mobilePoints = [
  "80,17 113,36 113,74 80,93 47,74 47,36",
  "160,17 193,36 193,74 160,93 127,74 127,36",
  "240,17 273,36 273,74 240,93 207,74 207,36",
  "120,74 153,93 153,131 120,150 87,131 87,93",
  "200,74 233,93 233,131 200,150 167,131 167,93",
  "80,131 113,150 113,188 80,207 47,188 47,150",
  "160,131 193,150 193,188 160,207 127,188 127,150",
  "240,131 273,150 273,188 240,207 207,188 207,150",
  "120,188 153,207 153,245 120,264 87,245 87,207",
  "200,188 233,207 233,245 200,264 167,245 167,207",
  "80,245 113,264 113,302 80,321 47,302 47,264",
  "160,245 193,264 193,302 160,321 127,302 127,264",
  "240,245 273,264 273,302 240,321 207,302 207,264"
] -%}
{%- set mobileCenters = [
  [80, 55], [160, 55], [240, 55],
  [120, 112], [200, 112],
  [80, 169], [160, 169], [240, 169],
  [120, 226], [200, 226],
  [80, 283], [160, 283], [240, 283]
] -%}

<div class="domain-honeycomb" id="domains">
<svg class="domain-honeycomb__svg domain-honeycomb__svg--desktop" viewBox="65 18 451 254" xmlns="http://www.w3.org/2000/svg" role="list" aria-label="Domains with verified analysis">
{%- for domain in collections.verifiedDomains -%}
{%- set i = loop.index0 -%}
{%- if i < 13 -%}
{%- set label = domainLabel.short(domain) -%}
{%- set words = label.split(" ") -%}
{%- set n = words | length -%}
{%- set cx = desktopCenters[i][0] -%}
{%- set cy = desktopCenters[i][1] -%}
<a class="domain-honeycomb__cell" href="{{ domain.data.honeycombLink or domain.url }}" aria-label="{{ domainLabel.full(domain) }}" role="listitem"><polygon class="domain-honeycomb__shape" points="{{ desktopPoints[i] }}"/>{% if n == 1 %}<text class="domain-honeycomb__label" x="{{ cx }}" y="{{ cy }}">{{ label }}</text>{% elif n == 2 %}<text class="domain-honeycomb__label"><tspan x="{{ cx }}" y="{{ cy - 7 }}">{{ words[0] }}</tspan><tspan x="{{ cx }}" y="{{ cy + 7 }}">{{ words[1] }}</tspan></text>{% else %}<text class="domain-honeycomb__label"><tspan x="{{ cx }}" y="{{ cy - 7 }}">{{ words[0] | safe }} {{ words[1] | safe }}</tspan><tspan x="{{ cx }}" y="{{ cy + 7 }}">{{ words[2] | safe }}</tspan></text>{% endif %}</a>
{%- endif -%}
{%- endfor -%}
</svg>
<svg class="domain-honeycomb__svg domain-honeycomb__svg--mobile" viewBox="0 0 320 340" xmlns="http://www.w3.org/2000/svg" role="list" aria-label="Domains with verified analysis">
{%- for domain in collections.verifiedDomains -%}
{%- set i = loop.index0 -%}
{%- if i < 13 -%}
{%- set label = domainLabel.short(domain) -%}
{%- set words = label.split(" ") -%}
{%- set n = words | length -%}
{%- set cx = mobileCenters[i][0] -%}
{%- set cy = mobileCenters[i][1] -%}
<a class="domain-honeycomb__cell" href="{{ domain.data.honeycombLink or domain.url }}" aria-label="{{ domainLabel.full(domain) }}" role="listitem"><polygon class="domain-honeycomb__shape" points="{{ mobilePoints[i] }}"/>{% if n == 1 %}<text class="domain-honeycomb__label domain-honeycomb__label--sm" x="{{ cx }}" y="{{ cy }}">{{ label }}</text>{% elif n == 2 %}<text class="domain-honeycomb__label domain-honeycomb__label--sm"><tspan x="{{ cx }}" y="{{ cy - 7 }}">{{ words[0] }}</tspan><tspan x="{{ cx }}" y="{{ cy + 7 }}">{{ words[1] }}</tspan></text>{% else %}<text class="domain-honeycomb__label domain-honeycomb__label--sm"><tspan x="{{ cx }}" y="{{ cy - 7 }}">{{ words[0] | safe }} {{ words[1] | safe }}</tspan><tspan x="{{ cx }}" y="{{ cy + 7 }}">{{ words[2] | safe }}</tspan></text>{% endif %}</a>
{%- endif -%}
{%- endfor -%}
</svg>
</div>
