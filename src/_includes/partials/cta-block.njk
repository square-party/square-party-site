{#
  cta-block.njk — mode-aware calls to action.
  Emits one CTA list per mode, each in a block with data-mode-show.
  Neutral mode typically has no CTAs and renders nothing.

  Required in scope: profile.ctaByMode

  TBD rule: if a CTA's href contains the string "TBD", the CTA renders as
  static text (no <a> element) rather than a live link. This matches the
  authoring discipline from the M2 prototype spec. PUBLIC_CONTENT M4 supplies
  real URLs; until then the label is surfaced without a link destination.
#}

{%- macro renderCta(cta) %}
  <li class="cta-block__item cta-block__item--{{ cta.kind | default('other') }}">
    {%- if cta.href and "TBD" not in cta.href %}
      <a class="cta-block__link" href="{{ cta.href }}">{{ cta.label }}</a>
    {%- else %}
      <span class="cta-block__link cta-block__link--pending" title="Link destination pending — check back after M4 content authoring">{{ cta.label }}</span>
    {%- endif %}
    {%- if cta.description %}
      <span class="cta-block__desc">{{ cta.description }}</span>
    {%- endif %}
  </li>
{%- endmacro %}
{#- Synthesis #}
{%- if profile.ctaByMode.synthesis and profile.ctaByMode.synthesis.length %}
<div class="cta-block mode-content" data-mode-show="synthesis">
  <ul class="cta-block__list" aria-label="Next steps — synthesis view">
    {%- for cta in profile.ctaByMode.synthesis %}
      {{ renderCta(cta) }}
    {%- endfor %}
  </ul>
</div>
{%- endif %}
{#- Design view #}
{%- if profile.ctaByMode.designView and profile.ctaByMode.designView.length %}
<div class="cta-block mode-content" data-mode-show="design">
  <ul class="cta-block__list" aria-label="Next steps — design view">
    {%- for cta in profile.ctaByMode.designView %}
      {{ renderCta(cta) }}
    {%- endfor %}
  </ul>
</div>
{%- endif %}
{#- Gap view #}
{%- if profile.ctaByMode.gapView and profile.ctaByMode.gapView.length %}
<div class="cta-block mode-content" data-mode-show="gap">
  <ul class="cta-block__list" aria-label="Next steps — gap view">
    {%- for cta in profile.ctaByMode.gapView %}
      {{ renderCta(cta) }}
    {%- endfor %}
  </ul>
</div>
{%- endif %}
{#- Neutral — no CTAs by spec; block omitted entirely. #}
