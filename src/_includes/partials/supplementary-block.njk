</div>
{%- endif %}
{#- Neutral #}
{%- if supp.neutral %}
<div class="mode-content" data-mode-show="neutral">
  <section class="supplementary-block supplementary-block--{{ supp.neutral.kind }}">
    <details>
      <summary class="supplementary-block__heading">
