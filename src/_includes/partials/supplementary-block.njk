    </details>
  </section>
</div>
{%- endif %}
{#- Gap view #}
{%- if supp.gapView %}
<div class="mode-content" data-mode-show="gap">
  <section class="supplementary-block supplementary-block--{{ supp.gapView.kind }}">
    <details>
      <summary class="supplementary-block__heading">
        {{ supp.gapView.title }}
        <span class="supplementary-block__kind-tag">{{ supp.gapView.kind }}</span>
