{#
  framing-block.njk — page-level mode-aware framing copy.
  Reserved for WM-1D (D9 page restructure). This partial is NOT used by
  the profile card itself; it replaces the existing .layered-section asides
  on the D9 home page when WM-1D lands.

  When called (WM-1D context):
  - framingByMode must be available in scope — either via page frontmatter
    or a set block in the calling template.
  - The [data-mode] wrapper on the page-level toggle widget drives visibility,
    same contract as profile-card.njk.

  Content shape expected (from M2 addendum §4, framingByMode):
    framingByMode.synthesis  — full-picture framing
    framingByMode.designView — what currently lives in "Where there's traction"
    framingByMode.gapView    — what currently lives in "What's at stake"
    framingByMode.neutral    — mechanical scope description

  Stub in place. WM-1D brief will specify the exact data source and
  calling convention.
#}

{%- if framingByMode %}
<div class="framing-block mode-content" data-mode-show="synthesis">
  <div class="framing-block__content framing-block__content--synthesis">
    {{ framingByMode.synthesis | safe }}
  </div>
</div>
<div class="framing-block mode-content" data-mode-show="design">
  <div class="framing-block__content framing-block__content--design">
    {{ framingByMode.designView | safe }}
  </div>
</div>
<div class="framing-block mode-content" data-mode-show="gap">
  <div class="framing-block__content framing-block__content--gap">
    {{ framingByMode.gapView | safe }}
  </div>
</div>
<div class="framing-block mode-content" data-mode-show="neutral">
  <div class="framing-block__content framing-block__content--neutral">
    {{ framingByMode.neutral | safe }}
  </div>
</div>
{%- else %}
  {#- framing-block.njk: framingByMode not in scope.
      Set framingByMode in page frontmatter or via a set block before including.
      This partial is reserved for WM-1D; not used in WM-1B profile cards. -#}
{%- endif %}
