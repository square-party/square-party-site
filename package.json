{
  "name": "square-party-site",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "clean": "rm -rf _site",
    "build": "npm run clean && eleventy",
    "deploy": "cd square-generator-backend/worker && npx wrangler deploy -c wrangler.toml",
    "build:sandbox": "eleventy --output=_site-sandbox"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "wrangler": "^4.83.0"
  }
}
